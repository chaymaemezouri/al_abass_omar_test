# Env (secrets stay on the VPS only)
.env
.env.*
!.env.example

# Avatar Virtuel nested secrets / runtime (keep source, never commit secrets)
Avatar_Virtuel/.env
Avatar_Virtuel/.env.*
!Avatar_Virtuel/.env.example
!Avatar_Virtuel/.env.production.example
Avatar_Virtuel/.git/
Avatar_Virtuel/nginx/certs/*.pem
Avatar_Virtuel/backend/.pytest_cache/
Avatar_Virtuel/**/__pycache__/
Avatar_Virtuel/**/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Windows reserved junk
NUL
Avatar_Virtuel/NUL
