# =============================================================================
# Avatar Virtuel — Assistant Conversationnel IA
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_NAME=Avatar Virtuel Al Abass Omar
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- Admin ---
ADMIN_API_KEY=change-me-admin-key-min-32-chars-xxxxxxxx

# --- CORS (comma-separated origins, never * in production) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=avatar_app
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=avatar_kb
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://avatar_app:change-me-strong-db-password@db:5432/avatar_kb

# --- Rate limiting ---
RATE_LIMIT_CHAT=120/minute
RATE_LIMIT_AUDIO=60/minute

# --- Session retention (hours) ---
SESSION_RETENTION_HOURS=24

# --- RAG (Gemini embeddings — free tier) ---
RAG_SIMILARITY_THRESHOLD=0.50
RAG_TOP_K=3
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- LLM (Gemini reformulation) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
TRANSLATION_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=

# --- STT ---
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=base

# --- TTS (edge-tts in dev with espeak-ng fallback; elevenlabs for final demo) ---
TTS_PROVIDER=espeak
# Alternatives: espeak | elevenlabs
TTS_VOICE_FR=fr-FR-HenriNeural
TTS_VOICE_AR=ar-MA-JamalNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Avatar (heygen or did; mock for offline dev) ---
AVATAR_PROVIDER=mock
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
DID_API_KEY=
DID_SOURCE_URL=

# --- Media ---
MEDIA_ROOT=/app/media
MAX_AUDIO_UPLOAD_MB=15

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
