# Copy to /var/www/avatar-candidat/shared/.env on the VPS only.
# Never commit a real .env. Never put secrets in GitHub Actions workflows.

LOVABLE_API_KEY=
PORT=3010
HOST=127.0.0.1

# Backend Avatar Virtuel (FastAPI) — local docker default :8000
VITE_AVATAR_API_URL=http://localhost:8000
# true = HeyGen lip-sync video (30–60s). false = Edge TTS + static portrait.
VITE_HEYGEN_VIDEO=true
