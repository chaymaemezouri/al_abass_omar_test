# =============================================================================
# Avatar Virtuel — Production environment template
# Copy to .env on the VPS (NEVER commit the real .env).
# Replace every CHANGE_ME / your-subdomain value before going live.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_NAME=Avatar Virtuel Al Abass Omar
SECRET_KEY=CHANGE_ME_long_random_64_chars_min

ADMIN_API_KEY=CHANGE_ME_admin_key_min_32_chars

# Public HTTPS origin only (no *, no localhost in prod)
CORS_ORIGINS=https://YOUR_SUBDOMAIN.example.com

POSTGRES_USER=avatar_app
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=avatar_kb
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://avatar_app:CHANGE_ME_strong_db_password@db:5432/avatar_kb

RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_AUDIO=15/minute
SESSION_RETENTION_HOURS=24

# RAG — validated: OOS detection 100% at 0.65; natural citizen recall improved
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=3

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
TRANSLATION_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=CHANGE_ME_gemini_key

# Media (leave mock/edge until demo day)
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=small
TTS_PROVIDER=edge
AVATAR_PROVIDER=mock
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# DID_API_KEY=
# DID_SOURCE_URL=

MEDIA_ROOT=/app/media
MAX_AUDIO_UPLOAD_MB=15

# Frontend build-time public API URL (same host via Nginx)
NEXT_PUBLIC_API_URL=https://YOUR_SUBDOMAIN.example.com

# Domain used by deploy scripts / nginx (no scheme)
AVATAR_DOMAIN=YOUR_SUBDOMAIN.example.com
